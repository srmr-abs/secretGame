{
  "name": "the-great-secret-unlock",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "next dev -H localhost -p 3000",
    "build": "next build && npm run typecheck:server",
    "start": "concurrently -k -n backend,frontend -c yellow,cyan \"tsx server/src/index.ts\" \"next start -H localhost -p 3000\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "admin:hash": "tsx scripts/create-admin-hash.ts",
    "seed": "tsx scripts/seed-puzzles.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "postcss": "^8.5.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
