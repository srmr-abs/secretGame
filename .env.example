# Frontend uses a same-origin /api rewrite to reach this local backend.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Local Express + Socket.IO backend
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Admin login. Generate the scrypt hash with: npm run admin:hash -- 'a-long-password'
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Use a long random value, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-secure-random-secret
